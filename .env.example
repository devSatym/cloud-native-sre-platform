# Local application configuration. Copy to .env only for local use; never add
# real credentials to this repository.
REDIS_URL=redis://localhost:6379
PAYMENTS_URL=http://localhost:8001
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Load tests use this public API base URL. For a port-forwarded GKE release,
# set it to http://localhost:<forwarded-port>/api.
K6_BASE_URL=http://localhost:8080/api
